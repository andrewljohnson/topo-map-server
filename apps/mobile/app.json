{
  "expo": {
    "name": "Topo Maps",
    "slug": "topo-map-server",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Connect to your local map tile server."
      },
      "bundleIdentifier": "dev.topomap.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.topomap.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your position and record GPS points and trip statistics while the app is in the foreground.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Continue recording your GPS route when the screen is locked or the app is in the background, only when you enable background recording."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "e8ec422e-d434-4d24-ad3a-c9ad6b1d86f7"
      }
    },
    "owner": "andrewljohnson"
  }
}
