{
  "name": "@topo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node scripts/bundle-map.mjs && expo start --lan",
    "bundle:map": "node scripts/bundle-map.mjs",
    "typecheck": "tsc --noEmit",
