# On server only: /srv/topo-map/secrets/storage.env (chmod 600)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-bucket-scoped-runtime-key
AWS_SECRET_ACCESS_KEY=replace-with-runtime-secret
# Optional R2 alternative: use its bucket-scoped S3 key and secret, region auto.
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
