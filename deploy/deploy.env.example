# Copy to ignored deploy/deploy.env on your computer.
# SSH host alias is supported; authentication stays in your SSH configuration.
DEPLOY_HOST=topo-production
DEPLOY_ROOT=/srv/topo-map
# Fetch origin/main when a remote is configured. Without a remote, use local main.
DEPLOY_REMOTE=origin
# Optional path to the existing GNIS/ranking/RIDB data artifacts.
# SEED_DATA_DIR=/path/to/topo-data
