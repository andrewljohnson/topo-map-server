{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow","Action":"s3:ListBucket","Resource":"arn:aws:s3:::REPLACE_BUCKET","Condition":{"StringLike":{"s3:prefix":["tiles/v1/*"]}}},
